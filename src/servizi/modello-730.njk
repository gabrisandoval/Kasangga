  <div class="doc-grid">

    <div class="doc-card">
      <h3>Documenti personali</h3>
      <ul>
        <li>Documento d'identità in corso di validità</li>
        <li>Codice fiscale (tessera sanitaria)</li>
        <li>Dati del coniuge e dei familiari a carico (CF, reddito)</li>
      </ul>
    </div>

    <div class="doc-card">
      <h3>Redditi da lavoro e pensione</h3>
      <ul>
        <li>CU (Certificazione Unica) del datore di lavoro</li>
        <li>CU pensione (INPS o altro ente)</li>
        <li>Eventuali CU di altri redditi assimilati</li>
      </ul>
    </div>

    <div class="doc-card">
      <h3>Spese sanitarie</h3>
      <ul>
        <li>Scontrini farmacia e ticket sanitari</li>
        <li>Fatture medico specialista, dentista, oculista</li>
        <li>Spese per protesi, occhiali, lenti a contatto</li>
        <li>Spese veterinarie (animali domestici)</li>
      </ul>
    </div>

    <div class="doc-card">
      <h3>Casa e mutuo</h3>
      <ul>
        <li>Certificazione interessi passivi mutuo (prima casa)</li>
        <li>Visura catastale degli immobili posseduti</li>
        <li>Contratti di locazione (affitti attivi o passivi)</li>
        <li>Spese di ristrutturazione (fatture + bonifici parlanti)</li>
        <li>Spese per risparmio energetico (ecobonus)</li>
      </ul>
    </div>

    <div class="doc-card">
      <h3>Istruzione e figli</h3>
      <ul>
        <li>Rette universitarie e tasse scolastiche</li>
        <li>Spese asilo nido</li>
        <li>Spese per attività sportive dei figli (under 18)</li>
        <li>Libri scolastici universitari</li>
      </ul>
    </div>

    <div class="doc-card">
      <h3>Assicurazioni e previdenza</h3>
      <ul>
        <li>Premi assicurazione vita e infortuni</li>
        <li>Contributi versati a fondi pensione integrativi</li>
        <li>Contributi per colf e badanti</li>
      </ul>
    </div>

    <div class="doc-card">
      <h3>Altri redditi e detrazioni</h3>
      <ul>
        <li>Certificazioni di dividendi azionari</li>
        <li>Ricevute di erogazioni liberali (donazioni a ONLUS)</li>
        <li>Spese funebri (in caso di decesso di familiare)</li>
        <li>Spese per badante (con codice fiscale)</li>
        <li>730 dell'anno precedente</li>
      </ul>
    </div>

  </div>

